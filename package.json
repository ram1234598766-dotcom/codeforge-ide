{
  "name": "codeforge-ide",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web install --no-audit --no-fund && npm --prefix apps/web run build",
    "build:web": "npm --prefix apps/web install --no-audit --no-fund && npm --prefix apps/web run build",
    "dev:desktop": "pnpm --filter @codeforge/desktop dev",
    "dev:mobile": "pnpm --filter @codeforge/mobile start",
    "build:desktop": "pnpm --filter @codeforge/desktop build",
    "build:mobile": "pnpm --filter @codeforge/mobile build"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}