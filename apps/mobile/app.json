{
  "expo": {
    "name": "CodeForge",
    "slug": "codeforge",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "codeforge",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.codeforge.ide",
      "supportsTablet": true
    },
    "android": {
      "package": "com.codeforge.ide",
      "versionCode": 1,
      "permissions": ["INTERNET"],
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "pan"
    }
  }
}
