{
  "expo": {
    "name": "CodeForge",
    "slug": "codeforge",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "scheme": "codeforge",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/icon.png",
      "bundleIdentifier": "com.codeforge.ide",
      "supportsTablet": true
    },
    "android": {
      "package": "com.codeforge.ide",
      "versionCode": 1,
      "permissions": ["INTERNET"],
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#171b24"
      }
    }
  }
}
