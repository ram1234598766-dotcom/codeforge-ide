{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeForge",
  "version": "1.0.0",
  "identifier": "com.codeforge.ide",
  "build": {
    "devUrl": "https://codeforge-ide.vasudevaya.workers.dev/app",
    "frontendDist": "https://codeforge-ide.vasudevaya.workers.dev/app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CodeForge",
        "url": "https://codeforge-ide.vasudevaya.workers.dev/app",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
